# Copy to .env and fill in. Values come from developers.facebook.com > your app > WhatsApp > API Setup.

# Access token (temporary 24h token for testing, or a permanent System User token for production)
WHATSAPP_TOKEN=
# "Phone number ID" (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# Any secret string you make up; paste the same value as "Verify token" when configuring the webhook
WHATSAPP_VERIFY_TOKEN=
# App Settings > Basic > App Secret (lets the server reject requests that don't come from Meta)
WHATSAPP_APP_SECRET=

# YOUR phone number with country code, digits only (e.g. 972501234567). Everyone else is ignored.
OWNER_NUMBERS=
# Your time zone, used for entry dates (e.g. Asia/Jerusalem, Europe/London, America/New_York)
TIMEZONE=UTC

# Optional
# DATABASE_FILE=data/journal.db
# DRAFT_TTL_HOURS=12
# GRAPH_API_VERSION=v23.0
